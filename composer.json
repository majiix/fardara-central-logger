{
    "name": "fardara/central-logger",
    "description": "Standalone WordPress central logging backend for multi-plugin suites.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Fardara",
            "homepage": "https://fardara.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "scripts": {
        "test": "php tests/test-central-logger.php",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "szepeviktor/phpstan-wordpress": true
        }
    }
}
